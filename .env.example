# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Only OPENAI_API_KEY is required for live use.
# Set LLM_PROVIDER=fake and EMBEDDING_PROVIDER=fake to run with no key at all
# (deterministic stubs — used by the test suite and for offline demos).
# ---------------------------------------------------------------------------

# --- LLM / embeddings provider ---
LLM_PROVIDER=openai            # openai | fake
EMBEDDING_PROVIDER=openai      # openai | fake
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Hierarchical chunking ---
PARENT_CHUNK_TOKENS=1000
CHILD_CHUNK_TOKENS=200
PARENT_CHUNK_OVERLAP_TOKENS=100
CHILD_CHUNK_OVERLAP_TOKENS=30

# --- Qdrant (vector store) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=child_chunks

# --- Neo4j (graph store) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- Retrieval tuning ---
VECTOR_TOP_K=8
GRAPH_MAX_HOPS=2

# --- API ---
CORS_ORIGINS=http://localhost:3000
