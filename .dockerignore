# Backend build context is the repo root; keep it small and deterministic.
.git
.github
.venv
venv
env
**/__pycache__
*.egg-info
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov

# Frontend has its own build context (./frontend); never needed by the backend image.
frontend

# Tests and docs are not needed at runtime.
tests
docs

# Local env / secrets
.env
.env.*
!.env.example
